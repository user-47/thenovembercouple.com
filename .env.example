# Public URL (used in emails, sitemap, links)
NEXT_PUBLIC_SITE_URL=https://thenovembercouple.com

# Supabase — run supabase/schema.sql first. Service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — verify the sending domain in Resend first
RESEND_API_KEY=
EMAIL_FROM="The November Couple <hello@thenovembercouple.com>"
INQUIRY_TO_EMAIL=hello@thenovembercouple.com

# Protects /api/cron/reminders (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Cloudflare Turnstile (optional spam protection on the brand form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Affiliate IDs (optional — links work without them)
AFFILIATE_KLOOK_AID=
AFFILIATE_GYG_PARTNER_ID=
AFFILIATE_VIATOR_PID=
